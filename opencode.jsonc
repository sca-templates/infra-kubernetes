{
  "$schema": "https://opencode.ai/config.json",
  // Shared skills (same files used by Claude Code, Codex, VS Code, opencode).
  "skills": {
    "paths": [".claude/skills"]
  },
  // CodeGraph MCP server (repo-local, self-contained).
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  }
}
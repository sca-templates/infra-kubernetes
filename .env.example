# =============================================================================
# infra-kubernetes — Environment Variables
# =============================================================================
# Local: optional. Copy to `.env` (gitignored) to override defaults; `make`
# targets read it via `-include .env`. Nothing secret belongs here — Vault is
# the secrets SSOT; bootstrap material lands in `.secrets/` (gitignored too).
# =============================================================================

# ── Platform ──────────────────────────────────────────────────────────────────
# Environment profile rendered by ArgoCD: local | dev | qa | prod
ENV=local

# ── Git repository ───────────────────────────────────────────────────────────
# Source-of-truth repo. `make bootstrap` substitutes {{GIT_REPO_URL}} in the
# applied argocd/ manifests. Point this at the real repo before Phase 1.
GIT_REPO_URL=https://github.com/sca-templates/infra-kubernetes

# ── kind cluster (local substrate only) ──────────────────────────────────────
KIND_CLUSTER_NAME=sca-local

# ArgoCD Helm chart version used by `make bootstrap`.
ARGOCD_CHART_VERSION=9.5.22

# Optional: path to a kubeconfig for a non-default cluster.
KUBECONFIG=
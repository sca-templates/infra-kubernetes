# =============================================================================
# infra-kubernetes — Environment Variables
# =============================================================================
# Local: optional. Copy to `.env` (gitignored) to override defaults; `make`
# targets read it via `-include .env`. Nothing secret belongs here — Vault is
# the secrets SSOT; bootstrap material lands in `.secrets/` (gitignored too).
# The toolchain CLI lives in bootstrap/sca.sh (make prereqs / make doctor); it
# reads the profiles in this file too (INSTALL_DIR, KIND_CLUSTER_NAME, ...).
# =============================================================================

# ── Platform ──────────────────────────────────────────────────────────────────
# Environment profile rendered by ArgoCD: local | dev | qa | prod
ENV=local

# ── Git repository ───────────────────────────────────────────────────────────
# Source-of-truth repo. `make bootstrap` substitutes {{GIT_REPO_URL}} in the
# applied argocd/ manifests. Local dev can point this at the local git serve:
#   GIT_REPO_URL=git://<kind-gateway>:9418/sca-infra.git
# (managed by `make local-git-up`). Default: the real repo on GitHub.
GIT_REPO_URL=https://github.com/sca-templates/infra-kubernetes

# Branch/ref ArgoCD tracks in the source repo. Local dev mirrors the working
# tree via `make local-git-update` (HEAD -> refs/heads/$(GIT_TARGET_BRANCH));
# CI drives the cluster smoke from the PR head branch. Pass `-e 'GIT_TARGET_BRANCH=x'`
# on the make invocation if a branch other than the default is wanted.
GIT_TARGET_BRANCH=main

# ── kind cluster (local substrate only) ──────────────────────────────────────
KIND_CLUSTER_NAME=sca-local

# ArgoCD Helm chart version used by `make bootstrap`.
ARGOCD_CHART_VERSION=9.5.22

# Optional: path to a kubeconfig for a non-default cluster.
KUBECONFIG=
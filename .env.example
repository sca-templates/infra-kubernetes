# =============================================================================
# infra-kubernetes — Environment Variables
# =============================================================================
# Local: optional. Copy to `.env` (gitignored) to override defaults; `make`
# targets read it via `-include .env`. Nothing secret belongs here — Vault is
# the secrets SSOT; bootstrap material lands in `.secrets/` (gitignored too).
# The toolchain CLI lives in bootstrap/sca.sh (make prereqs / make doctor); it
# reads the profiles in this file too (INSTALL_DIR, ...).
# =============================================================================

# ── Platform ──────────────────────────────────────────────────────────────────
# Environment profile rendered by ArgoCD: local | dev | qa | prod
ENV=local

# ── Git repository ───────────────────────────────────────────────────────────
# Source-of-truth repo. `make bootstrap` substitutes {{GIT_REPO_URL}} in the
# applied argocd/ manifests. Local dev can point this at the local git serve:
#   GIT_REPO_URL=git://<floci-node-ip>:9418/sca-infra.git
# (managed by `make local-git-up`). Default: the real repo on GitHub.
GIT_REPO_URL=https://github.com/sca-templates/infra-kubernetes

# Branch/ref ArgoCD tracks in the source repo. Local dev mirrors the working
# tree via `make local-git-update` (HEAD -> refs/heads/$(GIT_TARGET_BRANCH));
# CI drives the cluster smoke from the PR head branch. Pass `-e 'GIT_TARGET_BRANCH=x'`
# on the make invocation if a branch other than the default is wanted.
GIT_TARGET_BRANCH=main

# ── ArgoCD ───────────────────────────────────────────────────────────────────
# ArgoCD Helm chart version used by `make bootstrap`.
ARGOCD_CHART_VERSION=9.5.22

# Optional: path to a kubeconfig for a non-default cluster.
KUBECONFIG=

# ── Cloud emulator (dev/CI tooling only — docs/ci-cd.md) ──────────────────────
# The cluster smoke stands up a local cloud emulator so cloud integration can
# be proven without a cloud account, IAM material or per-cloud configuration.
# This is NOT a platform component (no sync-wave, nothing rendered by ArgoCD).
CLOUD_PROVIDER=aws

# Emulator image and the in-cluster Service it is published under. Override the
# image only with a pinned version; the smoke defaults come from
# bootstrap/versions.sh (single source of truth for pins, never `latest`).
FLOCI_IMAGE=floci/floci:2.3.0
CLOUD_NAMESPACE=cloud

# Set to 0 to skip the cloud-integration smoke (equivalent to passing
# --no-cloud to bootstrap/smoke-ci.sh). The emulator itself is the EKS
# substrate, so it always runs on the cluster smoke path.
SMOKE_CLOUD=1

# ── Cluster substrate (dev/CI tooling only — docs/ci-cd.md) ───────────────────
# The platform runs on the emulated EKS substrate: Floci's real single-node k3s
# (bootstrap/eks-emulator.sh), profile `local`. There is no second substrate.
# EKS coordinates (emulator placeholders, never real AWS). Override the
# image only with a pinned version; defaults come from bootstrap/versions.sh.
FLOCI_EKS_CLUSTER=sca-eks
FLOCI_EKS_CONTEXT=floci-eks
FLOCI_EKS_NETWORK=sca-eks
FLOCI_EKS_ECR_REPO=sca-smoke
